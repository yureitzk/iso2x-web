{
  "name": "iso2x-web",
  "type": "module",
  "displayName": "ISO2X",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "npm run test:unit && npm run test:e2e",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "preview": "vite preview",
    "type-check": "tsc -p jsconfig.json && tsc -p tsconfig.sw.json",
    "format": "prettier --write ."
  },
  "author": "yureitzk",
  "license": "MIT",
  "description": "Web-based Xbox ISO converter.",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "client-zip": "^2.5.0",
    "file-selector": "^5.0.1",
    "iso2x": "^0.1.4",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "@types/yauzl-promise": "^4.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "fast-glob": "^3.3.3",
    "globals": "^17.11.0",
    "happy-dom": "^20.10.6",
    "prettier": "^3.8.4",
    "type-fest": "^5.8.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vitest": "^4.1.9",
    "vitest-mock-extended": "^5.1.1",
    "workbox-precaching": "^7.4.1",
    "yauzl-promise": "^4.0.0"
  }
}
